# Configuración de JIRA API
# Copia este archivo como .env.local y completa los valores

# Tu email de Atlassian/JIRA
JIRA_EMAIL=tu-email@empresa.com

# Tu dominio de JIRA (sin https://)
JIRA_DOMAIN=tu-empresa.atlassian.net

# API Token de JIRA (generar en: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_TOKEN=tu-api-token-aqui
